# Copy to .env for local work and fill in your Supabase project's values (Settings → API).
# Only PUBLISHABLE keys belong in VITE_* variables. Never put a service-role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PROJECT_ID=
# Cloudflare Turnstile on login/signup. PUBLIC site key only; leave empty to keep the feature off.
# The SECRET key goes in Supabase → Authentication → Bot and Abuse Protection, never here (see src/lib/turnstile.ts).
VITE_TURNSTILE_SITE_KEY=
# Google sign-in popup on this site's own domain (Google then shows skillloop.tn, not <project>.supabase.co).
# PUBLIC OAuth Web client ID (…apps.googleusercontent.com), same client as Supabase → Providers → Google.
# Empty = the old redirect flow through Supabase (see src/lib/google-signin.ts).
VITE_GOOGLE_CLIENT_ID=
# Public site origin for canonical URLs (e.g. https://your-domain). Dev falls back to http://localhost:8080;
# a production build without it emits no canonical tag.
VITE_SITE_URL=
# Google Search Console HTML-tag token (public by design): the content="…" value only. Empty = no tag.
VITE_GOOGLE_SITE_VERIFICATION=
# Self-service account deletion in Settings. Set to "on" ONLY after migration 20261025120000_account_deletion.sql
# is applied and verified; otherwise the page explains how to request deletion.
VITE_ACCOUNT_DELETION=
# SkillLoop Pro tools (videos, statistics, carnet themes). "on" ONLY after migration 20261030120000_pro_tools.sql is
# applied and verified (it needs VITE_PRO_PLAN=on too). The card & QR only needs VITE_PRO_PLAN.
VITE_PRO_TOOLS=
# Manual payments for SkillLoop Pro (D17 / transfer / Flouci). "on" ONLY after migration 20261103120000_payments.sql is
# applied and verified, VITE_PRO_PLAN=on, AND the legal side is ready (auto-entrepreneur card, accountant on VAT).
VITE_PAYMENTS=
# Where pros pay (public: shown to every payer). An empty value hides that method. RIB = 20 digits.
VITE_PAY_NAME=
VITE_PAY_D17=
VITE_PAY_RIB=
VITE_PAY_FLOUCI=
# Client reviews (stars + comments after a finished job). "on" ONLY after migrations 20261101120000_request_progress.sql
# and 20261105120000_reviews.sql are applied and verified (VITE_REQUEST_PROGRESS=on too).
VITE_REVIEWS=

# In-app notifications (the bell). "on" ONLY after migration 20261106120000_notifications.sql is applied and verified.
VITE_NOTIFICATIONS=
# Support chat with the team (help button on every page). "on" ONLY after 20261102120000_admin.sql,
# 20261106120000_notifications.sql and 20261106130000_support.sql are applied and verified (answer from /admin: VITE_ADMIN=on).
# Off = the help button still shows quick answers + contact@skillloop.tn.
VITE_SUPPORT=
# Optional public WhatsApp number for support (shown to everyone in the help panel). Empty = hidden.
VITE_SUPPORT_WHATSAPP=

# ── Offer-writing assistant (server only; none of these is ever sent to the browser) ──
# GROQ_API_KEY and AI_QUOTA_SECRET are SECRETS: never put them in this file or .env. Locally: `read -rs GROQ_API_KEY; export GROQ_API_KEY`
# in the terminal before `bun run dev`. In production: Cloudflare Worker Secrets. AI_QUOTA_SECRET gates the quota RPCs
# (the database stores only its SHA-256 hash); limits then come from the database (private.ai_settings).
# Non-secret settings (no VITE_ prefix, so they are never bundled):
# AI_ENABLED=false                  # kill switch; "true" turns the assistant on
# GROQ_MODEL=openai/gpt-oss-20b
# Dev-only fallback limits (used only while the AI quota migration is absent; production limits live in the database):
# AI_USER_DAILY=10                  # per user per rolling 24 h (bounded 1–50)
# AI_GLOBAL_DAILY=120               # all users per rolling 24 h (bounded 1–2000)
# AI_USER_COOLDOWN_SECONDS=10       # between two requests of one user (min 3)
# AI_TIMEOUT_MS=15000
