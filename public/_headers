# Headers for STATIC files only (JS/CSS/fonts/favicon served by Cloudflare Workers static assets from .output/public;
# they never pass through src/server.ts, which sets the full header set on pages). Nitro appends its own
# "/assets/*  cache-control: immutable" rule to this file at build time.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
